{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "out",
    "rootDir": ".",
    "sourceMap": true,
    "noEmit": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node", "mocha"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "out"]
}
